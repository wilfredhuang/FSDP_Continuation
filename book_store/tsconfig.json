{
  "compilerOptions": {
    /* -------------------- File Layout -------------------- */
    "rootDir": "./",
    "outDir": "./dist",

    /* -------------------- Environment -------------------- */
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],

    /* -------------------- Outputs -------------------- */
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    /* -------------------- Type Safety -------------------- */
    "strict": true,
    "noImplicitAny": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    /* -------------------- Import / Export Behavior -------------------- */
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,

    /* -------------------- Migration -------------------- */
    "allowJs": true,
    "checkJs": false,
    "isolatedModules": true
  },

  /* -------------------- Includes / Excludes -------------------- */
  "include": [
  "**/*.ts",
  "**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "public",
    "views"
  ]
}
