<!DOCTYPE html>
<html lang="en">
<head>
  <!-- ===== META ===== -->
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
  <meta name="theme-color" content="#03a6f3" />

  <title>{{title}}</title>

  <!-- ===== STYLES ===== -->
  <link rel="icon" href="https://img.icons8.com/emoji/48/000000/orange-book.png" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" />
<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />
  <link rel="stylesheet" href="/css/vendor/owl.carousel.min.css" />
  <link rel="stylesheet" href="/css/custom/styles.css" />
  <link rel="stylesheet" href="/css/custom/stripe.css" />
  <link href="https://fonts.googleapis.com/css?family=Montserrat:300,400,600,700,800&display=swap" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet" />

  <!-- ===== JS LIBRARIES (DEFERRED) ===== -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" defer></script>
  <script src="https://code.jquery.com/jquery-3.6.4.min.js" defer></script>
  <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js" defer></script>
  <link href="https://unpkg.com/gijgo@1.9.11/css/gijgo.min.css" rel="stylesheet" type="text/css" />
  <script src="https://unpkg.com/gijgo@1.9.11/js/gijgo.min.js" defer></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/ekko-lightbox/5.3.0/ekko-lightbox.min.js" defer></script>
  <script src="https://www.google.com/recaptcha/api.js" async defer></script>
</head>

<body>
  <!-- ===== NAVBAR ===== -->
  <div class="navbar-white sticky-top bg-white border-bottom">
    {{>_navbar}}
  </div>

  <!-- ===== COUPON PROMO ===== -->
  {{#if (checkPromo public_coupon)}}
    {{>_coupon-promo}}
  {{/if}}

  <!-- ===== FLASH MESSAGES ===== -->
  <div class="container" id="flash-container">
    {{>_msg}}
    {{>_errors}}
    {{>_flash-msg}}
  </div>

  <!-- ===== MAIN CONTENT ===== -->
  <div class="page-wrap">
    {{{body}}}

    <!-- Back-to-top -->
    <button onclick="topFunction()" id="myBtn" title="Go to top" class="btn btn-primary">
      <svg width="1em" height="1em" viewBox="0 0 16 16" class="bi bi-chevron-up" fill="currentColor"
        xmlns="http://www.w3.org/2000/svg">
        <path fill-rule="evenodd"
          d="M7.646 4.646a.5.5 0 0 1 .708 0l6 6a.5.5 0 0 1-.708.708L8 5.707l-5.646 5.647a.5.5 0 0 1-.708-.708l6-6z" />
      </svg>
    </button>
  </div>

  {{>_footer}}

  <!-- ===== ✅ TOAST CONTAINER ===== -->
  <div id="toast-container" class="toast-container position-fixed top-0 end-0 p-3" style="z-index:1100;">
  <div id="toastMessage"
       class="toast align-items-center text-bg-success border-0 shadow-lg"
       role="alert" aria-live="assertive" aria-atomic="true">
    <div class="d-flex">
      <div id="toastBody" class="toast-body fw-semibold">Item added to cart!</div>
      <button type="button" class="btn-close btn-close-white me-2 m-auto"
              data-bs-dismiss="toast" aria-label="Close"></button>
    </div>
  </div>
</div>


  <!-- ===== LOCAL JS ===== -->
  <script src="/js/libraries/owl.carousel.min.js" defer></script>
  <script src="/js/custom.js" defer></script>
  <script src="/js/search-order-id.js" defer></script>
  <script src="/js/product-book-search.js" defer></script>
  <script src="/js/cart_functions.js" defer></script>
  <script src="/js/easypost_api.js" defer></script>
  <script src="/js/scroll-button.js" defer></script>

  <!-- ===== ✅ TOAST + CART UPDATE ===== -->
  <script defer>
    document.addEventListener("DOMContentLoaded", () => {
      console.log("✅ DOM ready. bootstrap.Toast:", typeof bootstrap.Toast);

      // Toast Function
      window.showToast = function (message, type = "success") {
        const toastEl = document.getElementById("toastMessage");
        const toastBody = document.getElementById("toastBody");
        if (!toastEl || !toastBody) return;
        toastBody.textContent = message;
        toastEl.classList.remove("text-bg-success", "text-bg-danger", "text-bg-warning");
        toastEl.classList.add(`text-bg-${type}`);
        const toast = bootstrap.Toast.getOrCreateInstance(toastEl, { delay: 2500 });
        toastEl.classList.add("animate__animated", "animate__fadeInDown"); // ✨ Animation
        toast.show();
        setTimeout(() => toastEl.classList.remove("animate__fadeInDown"), 1000);
      };

      // Cart Badge
      window.updateCartBadge = function (newCount) {
        const badge = document.getElementById("cartCount");
        if (badge) badge.textContent = newCount;
      };

      // Add-to-Cart AJAX
      window.addToCart = async function (id, name) {
        const btn = document.getElementById(`btnAdd${id}`);
        const spin = document.getElementById(`spin${id}`);
        if (spin) spin.classList.remove("d-none");
        if (btn) btn.disabled = true;

        try {
          const res = await fetch(`/product/product-list/${id}`);
          const data = await res.json();
          if (data.success) {
            showToast(`${name} added to cart!`, "success");
            const match = document.cookie.match(/cartQty=(\\d+)/);
            if (match) updateCartBadge(match[1]);
          } else {
            showToast("Error adding to cart", "danger");
          }
        } catch (err) {
          console.error(err);
          showToast("Network error while adding to cart", "danger");
        } finally {
          if (spin) spin.classList.add("d-none");
          if (btn) btn.disabled = false;
        }
      };

      // 🧪 Test Toast
      // showToast("✅ Toast system ready!", "success");
    });
  </script>

  <!-- ===== RECAPTCHA & STRIPE ===== -->
  <script>
    function submitUserForm() {
      const response = grecaptcha.getResponse();
      if (response.length == 0) {
        document.getElementById("g-recaptcha-error").innerHTML =
          '<p style="color:red;">Please complete the recaptcha</p>';
        return false;
      }
      return true;
    }
    function verifyCaptcha() {
      document.getElementById("g-recaptcha-error").innerHTML = "";
    }
  </script>
  <script src="https://js.stripe.com/v3/"></script>

  <!-- ===== ✨ MODERN TOAST STYLE ===== -->
  <style>
    .glass-toast {
      backdrop-filter: blur(10px) saturate(180%);
      background: linear-gradient(135deg, rgba(25, 135, 84, 0.9), rgba(40, 167, 69, 0.8)) !important;
      color: #fff !important;
      border-radius: 0.75rem;
      box-shadow: 0 8px 25px rgba(0, 0, 0, 0.25);
      transition: transform 0.3s ease, opacity 0.3s ease;
    }

    .animate__fadeInDown {
      animation-duration: 0.7s;
    }

    .btn-close-white {
      filter: invert(1);
    }
  </style>
</body>
</html>
