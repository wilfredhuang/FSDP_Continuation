  <!-- Fonts & Icons -->
  <link href="https://fonts.googleapis.com/css?family=Montserrat:200,300,400,500,600,700,800,900" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
  <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">

  <!-- Carousel & Custom -->
  <link rel="stylesheet" type="text/css" href="/css/vendor/owl.carousel.min.css">
  <link rel="stylesheet" type="text/css" href="/css/custom/styles.css">
  <link rel="stylesheet" type="text/css" href="/css/custom/stripe.css">

  <!-- Favicon -->
  <link rel="icon" href="https://img.icons8.com/emoji/48/000000/orange-book.png" />

  <!-- Animate.css -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.0.0/animate.min.css" />

  <!-- jQuery -->
  <script src="https://code.jquery.com/jquery-3.3.1.min.js"
    integrity="sha384-tsQFqpEReu7ZLhBV2VZlAu7zcOV+rXbYlF2cqB8txI/8aZajjp4Bqd+V6D5IgvKT" crossorigin="anonymous"></script>

  <!-- Datepicker -->
  <link href="https://unpkg.com/gijgo@1.9.11/css/gijgo.min.css" rel="stylesheet" type="text/css" />
  <script src="https://unpkg.com/gijgo@1.9.11/js/gijgo.min.js" type="text/javascript"></script>

  <!-- Lightbox -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/ekko-lightbox/5.3.0/ekko-lightbox.css"
    crossorigin="anonymous" />
  <script src="https://cdnjs.cloudflare.com/ajax/libs/ekko-lightbox/5.3.0/ekko-lightbox.min.js"
    crossorigin="anonymous"></script>

  <!-- Axios -->
  <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
</head>

<body>
  <div class="navbar-white sticky-top bg-white border-bottom">
    {{>_navbar}}
  </div>

  {{#if (checkPromo public_coupon)}}
  {{>_coupon-promo}}
  {{/if}}

  <div class="container" id="flash-container">
    {{>_msg}}
    {{>_errors}}
    {{>_flash-msg}}
  </div>

  <div class="page-wrap">
    {{{body}}}

    <!-- Back-to-top -->
    <button onclick="topFunction()" id="myBtn" title="Go to top" class="btn btn-primary">
      <svg width="1em" height="1em" viewBox="0 0 16 16" class="bi bi-chevron-up" fill="currentColor"
        xmlns="http://www.w3.org/2000/svg">
        <path fill-rule="evenodd"
          d="M7.646 4.646a.5.5 0 0 1 .708 0l6 6a.5.5 0 0 1-.708.708L8 5.707l-5.646 5.647a.5.5 0 0 1-.708-.708l6-6z" />
      </svg>
    </button>
  </div>

  {{>_footer}}

<!-- ✅ Toast Container (add once near the bottom of <body>) -->
<div id="toast-container"
     class="toast-container position-fixed top-0 end-0 p-3"
     style="z-index:1100;">
  <div id="toastMessage"
       class="toast align-items-center text-bg-success border-0 shadow-lg"
       role="alert"
       aria-live="assertive"
       aria-atomic="true">
    <div class="d-flex">
      <div id="toastBody" class="toast-body fw-semibold">Item added to cart!</div>
      <button type="button"
              class="btn-close btn-close-white me-2 m-auto"
              data-bs-dismiss="toast"
              aria-label="Close"></button>
    </div>
  </div>
</div>

  <!-- JS Libraries -->
  <script src="/js/libraries/bootstrap.bundle.min.js"></script>
  <script src="/js/libraries/owl.carousel.min.js"></script>
  <script src="/js/custom.js"></script>
  <script src="/js/search-order-id.js"></script>
  <script src="/js/product-book-search.js"></script>
  <script src="/js/cart_functions.js"></script>
  <script src="/js/easypost_api.js"></script>
  <script src="/js/scroll-button.js"></script>

  <!-- ✅ Toast + Cart Badge + Add-to-Cart -->
  <script>
document.addEventListener("DOMContentLoaded", () => {
  console.log("✅ DOM loaded. Bootstrap Toast available:", typeof bootstrap.Toast);

  // --- Toast Function ---
  window.showToast = function (message, type = "success") {
    const toastEl = document.getElementById("toastMessage");
    const toastBody = document.getElementById("toastBody");

    if (!toastEl || !toastBody) {
      console.error("❌ Toast elements not found in DOM!");
      return;
    }

    toastBody.textContent = message;
    toastEl.classList.remove("text-bg-success", "text-bg-danger", "text-bg-warning");
    toastEl.classList.add(`text-bg-${type}`);

    // ✅ Use Bootstrap 5.3+ API
    const toast = bootstrap.Toast.getOrCreateInstance(toastEl, { delay: 2500 });
    toast.show();

    console.log("📢 Toast shown:", message);
  };

  // --- Cart Badge Update ---
  window.updateCartBadge = function (newCount) {
    const badge = document.getElementById("cartCount");
    if (badge) badge.textContent = newCount;
  };

  // --- Add-to-Cart AJAX ---
  window.addToCart = async function (id, name) {
    const btn = document.getElementById(`btnAdd${id}`);
    const spin = document.getElementById(`spin${id}`);
    if (spin) spin.classList.remove("d-none");
    if (btn) btn.disabled = true;

    try {
      const res = await fetch(`/product/product-list/${id}`);
      const data = await res.json();

      if (data.success) {
        showToast(`${name} added to cart!`, "success");
        const match = document.cookie.match(/cartQty=(\d+)/);
        if (match) updateCartBadge(match[1]);
      } else {
        showToast("Error adding to cart", "danger");
      }
    } catch (err) {
      console.error(err);
      showToast("Network error while adding to cart", "danger");
    } finally {
      if (spin) spin.classList.add("d-none");
      if (btn) btn.disabled = false;
    }
  };

  // 🧪 Optional: Verify toast works immediately
  // showToast("✅ Bootstrap Toast Works!");
});
  </script>

  <!-- Recaptcha + Stripe -->
  <script>
    function submitUserForm() {
      const response = grecaptcha.getResponse();
      if (response.length == 0) {
        document.getElementById("g-recaptcha-error").innerHTML =
          '<p style="color:red;">Please complete the recaptcha</p>';
        return false;
      }
      return true;
    }
    function verifyCaptcha() {
      document.getElementById("g-recaptcha-error").innerHTML = "";
    }
  </script>
  <script src="https://js.stripe.com/v3/"></script>

  <!-- ✨ Glass Gradient Toast Aesthetic -->
  <style>
    .glass-toast {
      backdrop-filter: blur(10px) saturate(160%);
      background: linear-gradient(135deg, rgba(25, 135, 84, 0.9), rgba(40, 167, 69, 0.8)) !important;
      color: #fff !important;
      border-radius: 0.75rem;
      box-shadow: 0 8px 25px rgba(0, 0, 0, 0.25);
      transition: transform 0.3s ease, opacity 0.3s ease;
    }

    .toast.show {
      transform: translateY(0);
      opacity: 1;
    }

    .toast.hide {
      opacity: 0;
      transform: translateY(-20px);
    }

    .btn-close-white {
      filter: invert(1);
    }
  </style>
</body>
</html>
