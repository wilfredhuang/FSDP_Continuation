@startuml
!theme plain
left to right direction
skinparam actorStyle awesome

title Bookstore Web Application - Use Case Diagram

actor "Customer" as C
actor "Admin" as A
actor "Stripe API" as Stripe
actor "Twilio API" as Twilio

rectangle "Bookstore Web System" {

  (Register / Login)
  (Browse Books)
  (Manage Cart)
  (Checkout)
  (Select Payment Method)
  (Pay via Stripe)
  (Pay via PayNow/PayLah)
  (Receive Order Confirmation)
  (Receive SMS Notification)
  (Apply Discount)
  (Apply Coupon)
  (Auto-Fill Delivery Details)

  (Create Discount)
  (Create Coupon)
  (Manage Discounts & Coupons)
  (Verify Manual Payment)
  (Manage Promotions)
  (View Admin Dashboard)
}

' --- Customer Actions ---
C --> (Register / Login)
C --> (Browse Books)
C --> (Manage Cart)
C --> (Checkout)
C --> (Select Payment Method)
C --> (Pay via Stripe)
C --> (Pay via PayNow/PayLah)
C --> (Apply Discount)
C --> (Apply Coupon)
C --> (Auto-Fill Delivery Details)
C --> (Receive Order Confirmation)
C --> (Receive SMS Notification)

' --- Admin Actions ---
A --> (Register / Login)
A --> (View Admin Dashboard)
A --> (Create Discount)
A --> (Create Coupon)
A --> (Manage Discounts & Coupons)
A --> (Verify Manual Payment)
A --> (Manage Promotions)

' --- External API Integrations ---
(Pay via Stripe) --> Stripe : <<include>>
(Receive SMS Notification) --> Twilio : <<include>>

' --- Logical Connections ---
(Checkout) --> (Select Payment Method) : <<include>>
(Select Payment Method) --> (Pay via Stripe) : <<extend>>
(Select Payment Method) --> (Pay via PayNow/PayLah) : <<extend>>
(Pay via Stripe) --> (Receive Order Confirmation) : <<include>>
(Pay via PayNow/PayLah) --> (Receive Order Confirmation) : <<include>>
(Receive Order Confirmation) --> (Receive SMS Notification) : <<include>>

@enduml
